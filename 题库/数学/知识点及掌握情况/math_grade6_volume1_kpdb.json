          "key_formulas": []
        },
        {
          "id": "u5.k5",
          "name": "比和分数、除法的关系",
          "rule": "a:b = a÷b = a/b，本质相同：a 是被除数(前项)，b 是除数(后项)，b≠0",
          "example": "3:4 = 3÷4 = 3/4 = 0.75",
          "key_formulas": [
            "a:b = a÷b = a/b"
          ]
        },
        {
          "id": "u5.k6",
          "name": "求比值",
          "rule": "比值 = 前项 ÷ 后项 (结果可是分数/小数/整数)",
