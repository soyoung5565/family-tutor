        {
          "id": "u2.k1",
          "name": "圆的认识（车轮为什么是圆的）",
          "rule": "圆是由一条封闭曲线围成的图形。圆心O、半径r、直径d，d=2r",
          "example": "同一个圆里所有半径都相等，所有直径都相等",
          "key_formulas": [
            "d = 2r",
            "r = d/2"
          ]
        },
        {
          "id": "u2.k2",
          "name": "圆的轴对称性",
          "rule": "圆是轴对称图形，有无数条对称轴（每条直径所在直线都是对称轴）",
          "example": "圆形车轮设计、轴对称设计",
          "key_formulas": [
            "圆的对称轴 = 无数条"
          ]
        },
        {
          "id": "u2.k3",
          "name": "用圆规画圆",
          "rule": "圆规两脚分开为半径，一脚固定圆心，另一脚旋转",
          "example": "画半径3cm的圆：两脚分开3cm，固定圆心旋转一周",
          "key_formulas": []
        },
        {
          "id": "u2.k4",
          "name": "圆周率 π",
          "rule": "圆的周长与直径的比值，π≈3.14159265... 我国祖冲之算出 π≈22/7 和 355/113",
          "example": "π 是无限不循环小数，2024年算到10^14位",
          "key_formulas": [
            "π ≈ 3.14159265",
            "祖冲之 π≈22/7 (约率), 355/113 (密率)"
          ]
        },
        {
          "id": "u2.k5",
          "name": "圆的周长公式",
          "rule": "C = 2πr = πd。π 取 3.14 计算",
          "example": "d=10cm, C=3.14×10=31.4 cm",
          "key_formulas": [
            "C = πd = 2πr"
          ]
        },
        {
          "id": "u2.k6",
          "name": "圆的面积公式推导",
          "rule": "圆切N等分拼成平行四边形（底≈πr, 高=r）→ S=πr²",
          "example": "r=4cm, S=3.14×16=50.24 cm²",
          "key_formulas": [
            "S = πr²",
            "S = π(d/2)² = πd²/4"
          ]
        },
        {
          "id": "u2.k7",
          "name": "圆环面积",
          "rule": "S = πR² - πr² = π(R²-r²)",
          "example": "外R=5, 内r=3, S=3.14×(25-9)=50.24",
          "key_formulas": [
            "S = π(R²-r²)"
          ]
        },
        {
          "id": "u2.k8",
          "name": "扇形",
          "rule": "由圆心角两条半径和弧围成。S = (圆心角度数/360) × πr²",
          "example": "r=4, 圆心角90°, S = 90/360×3.14×16 = 12.56",
          "key_formulas": [
            "S = (角度/360) × πr²"
          ]
        },
        {
          "id": "u2.k9",
          "name": "组合图形（跑道/草地）面积",
          "rule": "分割为已学图形（长方形+半圆、长方形+1/4圆等），分别算再相加减",
          "example": "跑道：长方形 + 2 个半圆 = 1 个整圆",
          "key_formulas": []
        },
        {
          "id": "u2.k10",
          "name": "修复铜镜（用四等分拼图）",
          "rule": "把圆用弧线外接正方形，看如何复原",
          "example": "齐家文化青铜镜",
          "key_formulas": []
        }
      ]
    },
