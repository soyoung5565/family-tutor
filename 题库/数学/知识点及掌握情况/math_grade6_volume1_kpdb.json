      "id": "u1",
      "name": "分数除法",
      "start_page": 7,
      "end_page": 15,
      "slide_range": "slide_007-015",
      "kps": [
        {
          "id": "u1.k1",
          "name": "分数除以整数",
          "rule": "分数÷整数 = 分数 × 1/整数",
          "example": "4/5 ÷ 3 = 4/5 × 1/3 = 4/15",
          "key_formulas": [
            "分数÷整数 = 分数 × (1/整数)",
            "例: 4/5 ÷ 3 = 4/15"
          ],
          "common_mistakes": [
            "分母漏乘"
          ]
        },
        {
          "id": "u1.k2",
          "name": "整数除以分数",
          "rule": "整数÷分数 = 整数 × 分数的倒数",
          "example": "6 ÷ 1/3 = 6 × 3 = 18",
          "key_formulas": [
            "整数÷分数 = 整数 × 倒数"
          ]
        },
        {
          "id": "u1.k3",
          "name": "分数除以分数",
          "rule": "分数÷分数 = 被除数 × 除数的倒数",
          "example": "2/3 ÷ 4/5 = 2/3 × 5/4 = 5/6",
          "key_formulas": [
            "分数÷分数 = 被除数 × 倒数",
            "除以一个分数等于乘它的倒数"
          ]
        },
        {
          "id": "u1.k4",
          "name": "倒数",
          "rule": "乘积是1的两个数互为倒数。求分数的倒数：分子分母调换位置",
          "example": "2/3 的倒数是 3/2",
          "key_formulas": [
            "1/a 的倒数 = a",
            "a/b 的倒数 = b/a",
            "0 没有倒数"
          ]
        },
        {
          "id": "u1.k5",
          "name": "分数除法的应用（量率对应）",
          "rule": "已知单位1的X%是Y，求单位1 = Y ÷ 分率",
          "example": "苹果的3/5是12千克，= 12 ÷ 3/5 = 20 千克",
          "key_formulas": [
            "单位1 = 已知量 ÷ 分率"
          ]
        },
        {
          "id": "u1.k6",
          "name": "列方程解分数除法",
          "rule": "设未知数x，把分率关系转为方程（部分量 = 单位1 × 分率）",
          "example": "一个数的2/3是8，求这个数：2/3 x = 8, x = 12",
          "key_formulas": []
        }
      ]
    },
    {
